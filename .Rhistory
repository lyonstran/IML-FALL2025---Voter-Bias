library(leaps)
leaps_model <- regsubsets(y ~ ., data = db, nvmax = 10)
summary_leaps <- summary(leaps_model)
summary_leaps$which
bic_values <- summary_leaps$bic
plot(1:length(bic_values), bic_values,
type = "b", xlab = "Model Size", ylab =
"BIC", main = "BIC vs Model Size")
min_bic_index <- which.min(bic_values)
min_bic_index
best_model_vars <- summary_leaps$which[min_bic_index, ]
best_model_vars
