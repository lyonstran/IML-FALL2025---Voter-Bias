qqnorm(std_residuals)
qqline(std_residuals)
model2 <- lm(I(1/glyhb) ~ frame * age, data = df)
anova(model2)
std_residuals2 <- rstandard(model2)
qqnorm(std_residuals2)
qqline(std_residuals2)
require('faraway')
vars <- c("chol", "stab.glu", "hdl",
"ratio", "age", "gender", "frame",
"height", "weight", "glyhb")
db <- diabetes[, vars]
db <- db[complete.cases(db),]
db$gender=1*(db$gender=="male")
db$framemed <- 1*(db$frame=="medium")
db$framelarge <- 1*(db$frame=="large")
db$BMI=db$weight*703/(db$height^2)  # Body Mass Index
db$y=(1/db$glyhb)
