library(leaflet)
ui <- fluidPage(
titlePanel("College Football Voter Bias Across the U.S."),
sidebarLayout(
sidebarPanel(
selectInput("team", "Select Team:",
choices = c("Alabama", "LSU", "Ohio State", "Michigan", "Oklahoma")),
selectInput("bias_metric", "Select Bias Metric:",
choices = c("bias1", "bias2", "bias3", "bias0_ap", "bias0_mean"),
selected = "bias0_mean")
),
mainPanel(
leafletOutput("bias_map", height = 650)
)
)
)
library(dplyr)
library(stringr)
library(readr)
library(leaflet)
library(shiny)
ui <- fluidPage(
titlePanel("College Football Voter Bias Across the U.S."),
sidebarLayout(
sidebarPanel(
selectInput("team", "Select Team:",
choices = c("Alabama", "LSU", "Ohio State", "Michigan", "Oklahoma")),
selectInput("bias_metric", "Select Bias Metric:",
choices = c("bias1", "bias2", "bias3", "bias0_ap", "bias0_mean"),
selected = "bias0_mean")
),
mainPanel(
leafletOutput("bias_map", height = 650)
)
)
)
server <- function(input, output) {
# Filter data when user selects team
team_data <- reactive({
full_df |> filter(team_focus == input$team)
})
output$bias_map <- renderLeaflet({
df <- team_data()
# aggregate bias per state
state_bias <- df |>
group_by(state) |>
summarise(avg_bias = mean(.data[[input$bias_metric]], na.rm = TRUE))
# join to US spatial table
plot_data <- left_join(us_states, state_bias,
by = c("NAME" = "state"))  # if state abbreviations: adjust to ABBREV
pal <- colorNumeric(
palette = "RdBu", domain = plot_data$avg_bias, reverse = TRUE
)
leaflet(plot_data) |>
addTiles() |>
addPolygons(
fillColor = ~pal(avg_bias),
fillOpacity = 0.75,
color = "white",
weight = 1,
label = ~paste(NAME, "<br>Avg Bias =", round(avg_bias, 3))
) |>
addLegend(
pal = pal, values = ~avg_bias,
title = paste(input$team, input$bias_metric, "bias"),
position = "bottomright"
)
})
}
shinyApp(ui, server)
